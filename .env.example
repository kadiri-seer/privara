# Privara configuration. Copy to .env (repository root) and adjust. Every variable is optional.
# Never commit a real .env — it is listed in .gitignore.

# --- Network -------------------------------------------------------------------------------
# Loopback only by default. `privara serve` refuses non-loopback hosts unless --allow-remote is passed.
PRIVARA_HOST=127.0.0.1
PRIVARA_PORT=8787
# Accepted Host headers (protects the localhost API from DNS-rebinding attacks).
PRIVARA_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Storage -------------------------------------------------------------------------------
# Defaults to ./data in the repository. Holds privara.db, vault.db, vault.key and the sandbox.
# PRIVARA_DATA_DIR=/absolute/path/to/privara-data
# The only directory agent file tools can touch. Defaults to <data dir>/sandbox.
# PRIVARA_SANDBOX_DIR=/absolute/path/to/sandbox

# --- Credentials ---------------------------------------------------------------------------
# Optional bootstrap admin key (any long random string). Only its hash is kept in memory.
# Prefer the key generated by `privara init`, which is stored as a hash in the database.
# PRIVARA_ADMIN_API_KEY=
# Agent key used by `privara mcp` (stdio transport). Usually set in the MCP client's config instead.
# PRIVARA_AGENT_KEY=

# --- Detection -----------------------------------------------------------------------------
PRIVARA_NLP_ENABLED=true
# Any installed spaCy pipeline. Larger models (en_core_web_md / en_core_web_lg) find more names.
PRIVARA_NLP_MODEL=en_core_web_sm

# --- Limits --------------------------------------------------------------------------------
PRIVARA_MAX_REQUEST_BYTES=262144
PRIVARA_MAX_TEXT_CHARS=50000
PRIVARA_MAX_FILE_BYTES=1048576
# Lifetime of an approval token after a human approves (seconds). Also adjustable in Settings.
PRIVARA_APPROVAL_TTL_SECONDS=300
# How long a request may wait for a decision before it expires (seconds).
PRIVARA_PENDING_APPROVAL_TTL_SECONDS=3600

# --- Features ------------------------------------------------------------------------------
PRIVARA_MCP_HTTP_ENABLED=true
# "hosted" when running behind a platform's HTTPS proxy (the Dockerfile sets this). See docs/DEPLOY.md.
PRIVARA_DEPLOYMENT=local
PRIVARA_AUTH_FAILURES_PER_MINUTE=20
PRIVARA_LOG_LEVEL=INFO
